# Copy to .env and fill in real values: cp .env.example .env

# PostgreSQL
DB_NAME=taskdb
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Only needed when running the app outside Docker:
DB_URL=jdbc:postgresql://localhost:5432/taskdb

# JWT signing key: random string, at least 32 characters
# e.g. openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRATION=86400000
